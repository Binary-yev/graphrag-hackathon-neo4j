# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# The values come from the Aura console credential file (kept in keys/, also gitignored).

NEO4J_URI="neo4j+s://YOUR_DATABASE_ID.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="YOUR_PASSWORD"
NEO4J_DATABASE="neo4j"

# Hosted Aura MCP endpoint for this instance (Aura console -> instance -> MCP).
AURA_MCP_URL="https://YOUR_INSTANCE_ID.mcp-instances.neo4j.io"

# --- Optional: only needed once we start pulling source data ---
# Google Cloud project used for BigQuery public-dataset queries.
GCP_PROJECT_ID=""

# Embedding/LLM provider key, if we generate embeddings outside the coding agent.
# OPENAI_API_KEY=""
